{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darumappap.github.io/UnitySubAgentHub/schemas/subagent-catalog-snapshot.schema.json",
  "title": "Consumer-neutral SubAgent Catalog Snapshot",
  "description": "Versioned static Hub contracts; no runtime profile, route, environment observation or selected provider.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "specialists"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "kind": {
      "const": "subagent_catalog_snapshot"
    },
    "specialists": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "manifest_ref",
          "manifest"
        ],
        "properties": {
          "manifest_ref": {
            "type": "string",
            "pattern": "^SubAgents/[a-z][a-z0-9_]*_subagent/manifest\\.yaml$"
          },
          "manifest": {
            "type": "object"
          }
        }
      }
    }
  }
}
