{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProfilerObservation",
  "type": "object",
  "additionalProperties": false,
  "required": ["measurement_source", "platform", "unity_version", "graphics_api", "build_type", "capture_mode", "capture_scope", "measurement_window", "observed_at", "sample_count", "counter_names", "counter_units", "render_counters", "known_limitations", "validity", "measurements"],
  "properties": {
    "measurement_source": {"const": "unity_pipeline.get_performance_stats"},
    "platform": {"type": "string", "minLength": 1},
    "unity_version": {"type": "string", "minLength": 1},
    "graphics_api": {"type": "string", "minLength": 1},
    "build_type": {"const": "Editor"},
    "capture_mode": {"const": "editor_snapshot"},
    "capture_scope": {"type": "string", "minLength": 1},
    "measurement_window": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "sample_count": {"const": 1},
    "counter_names": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "counter_units": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "render_counters": {"type": "object", "required": ["drawCalls", "batches", "setPassCalls", "triangles", "vertices"], "additionalProperties": false, "properties": {"drawCalls": {"type": "integer", "minimum": 0}, "batches": {"type": "integer", "minimum": 0}, "setPassCalls": {"type": "integer", "minimum": 0}, "triangles": {"type": "integer", "minimum": 0}, "vertices": {"type": "integer", "minimum": 0}}},
    "known_limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "validity": {"const": "limited"},
    "measurements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capture_id", "metadata", "metrics"],
        "properties": {
          "capture_id": {"type": "string", "minLength": 1},
          "metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": ["measurement_source", "unity_version", "platform", "graphics_api", "capture_mode", "build_type", "scene_or_scope", "measurement_window", "known_limitations", "validity"],
            "properties": {
              "measurement_source": {"type": "string", "minLength": 1},
              "unity_version": {"type": "string", "minLength": 1},
              "platform": {"type": "string", "minLength": 1},
              "graphics_api": {"type": "string", "minLength": 1},
              "capture_mode": {"type": "string", "minLength": 1},
              "build_type": {"const": "Editor"},
              "scene_or_scope": {"type": "string", "minLength": 1},
              "measurement_window": {"type": "string", "minLength": 1},
              "known_limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "validity": {"const": "limited"}
            }
          },
          "metrics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "value", "unit", "category"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "value": {"type": "number", "minimum": 0},
                "unit": {"type": "string", "minLength": 1},
                "category": {"enum": ["cpu", "gpu", "memory", "gc", "io_loading"]}
              }
            }
          }
        }
      }
    }
  }
}
