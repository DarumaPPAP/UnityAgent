{
  "schema_version": "1.0",
  "repository": "DarumaPPAP/UnityAgent",
  "default_branch": "main",
  "working_branch_regex": "^(feature|fix|chore|release)/[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$",
  "branches": {
    "main": {
      "purpose": "常に統合済みの正本",
      "lifetime": "permanent"
    },
    "feature/*": {
      "purpose": "新機能",
      "lifetime": "delete_after_pr_merge"
    },
    "fix/*": {
      "purpose": "不具合修正",
      "lifetime": "delete_after_pr_merge"
    },
    "chore/*": {
      "purpose": "CI・Docs・Refactor・Repository整理",
      "lifetime": "delete_after_pr_merge"
    },
    "release/*": {
      "purpose": "Release準備が本当に必要な場合だけ",
      "lifetime": "delete_after_release"
    }
  },
  "rules": {
    "normal_pr_base": "main",
    "working_branches_merge_via_pull_request": true,
    "squash_merge_only": true,
    "delete_head_branch_after_merge": true
  }
}
