{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darumappap.github.io/UnitySubAgentHub/schemas/subagent-manifest.schema.json",
  "title": "SubAgent Manifest",
  "description": "Portable SubAgent identity and contract metadata. Installation and environment eligibility are resolved by UnityAgent at runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "identity",
    "lifecycle",
    "installation",
    "activation",
    "capabilities",
    "capability_contract_ref",
    "compatibility",
    "dependencies",
    "backends",
    "evidence",
    "execution"
  ],
  "properties": {
    "schema_version": {
      "const": "5.0"
    },
    "kind": {
      "const": "subagent_manifest"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*_subagent$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lifecycle": {
      "enum": [
        "active",
        "deprecated",
        "retired",
        "revoked"
      ]
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "required",
        "auto_install"
      ],
      "properties": {
        "mode": {
          "const": "optional"
        },
        "required": {
          "const": false
        },
        "auto_install": {
          "const": false
        }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_before_resolution",
        "false_behavior",
        "unknown_behavior"
      ],
      "properties": {
        "required_before_resolution": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "false_behavior": {
          "const": "exclude_from_resolution"
        },
        "unknown_behavior": {
          "const": "exclude_from_resolution"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "operations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "capability_contract_ref": {
      "type": "string",
      "minLength": 1
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported_targets"
      ],
      "properties": {
        "supported_targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "unity_version",
              "render_pipeline"
            ],
            "properties": {
              "unity_version": {
                "type": "string",
                "minLength": 1
              },
              "render_pipeline": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "required"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "backend",
              "unity_package",
              "unity_module",
              "tool"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "eligibility_gate": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "backends": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "contract_ref"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "kind": {
            "enum": [
              "cli",
              "unity_package",
              "http",
              "rpc",
              "library"
            ]
          },
          "contract_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "required_artifacts",
        "runtime_types",
        "terminal_states"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "required_artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "runtime_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "terminal_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "verified",
              "partial_verified",
              "blocked_by_environment",
              "unavailable"
            ]
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "oneOf": [
        {
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "provider_backed"
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "kind",
            "reasoning_runtime",
            "instructions_ref",
            "output_contract_ref",
            "source_context_binding",
            "required_observation_capabilities",
            "execution_mode"
          ],
          "properties": {
            "kind": {
              "const": "reasoning"
            },
            "reasoning_runtime": {
              "const": "codex_runner"
            },
            "instructions_ref": {
              "type": "string",
              "minLength": 1
            },
            "output_contract_ref": {
              "type": "string",
              "minLength": 1
            },
            "source_context_binding": {
              "const": "required"
            },
            "required_observation_capabilities": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
              }
            },
            "execution_mode": {
              "enum": [
                "planning_only",
                "read_only_analysis"
              ]
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "execution": {
          "properties": {
            "kind": {
              "const": "provider_backed"
            }
          }
        },
        "backends": {
          "minItems": 1
        }
      }
    },
    {
      "properties": {
        "execution": {
          "properties": {
            "kind": {
              "const": "reasoning"
            }
          }
        },
        "backends": {
          "maxItems": 0
        }
      }
    }
  ]
}
