{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darumappap.github.io/UnitySubAgentHub/schemas/subagent-registry.schema.json",
  "title": "SubAgent Registry",
  "description": "An index of canonical specialist manifests. Runtime decisions belong to UnityAgent.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "entries"],
  "properties": {
    "schema_version": { "const": "2.0" },
    "kind": { "const": "subagent_registry" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["manifest"],
        "properties": {
          "manifest": { "type": "string", "pattern": "^subagent/[a-z][a-z0-9_]*_subagent/manifest\\.yaml$" }
        }
      }
    }
  }
}
